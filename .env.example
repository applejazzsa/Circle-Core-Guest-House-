SECRET_KEY=change-me-to-a-long-random-secret-use-python-secrets-token-urlsafe-50
ENVIRONMENT=development
APP_VERSION=development
DEBUG=False
ALLOWED_HOSTS=guesthouse.circlecore.co.za,.guesthouse.circlecore.co.za
BASE_DOMAIN=guesthouse.circlecore.co.za
ADMIN_URL=admin/  # SECURITY: change this to a random path e.g. admin-a7f3c9kx/

# PostgreSQL (required — django-tenants does not support SQLite)
DB_NAME=circlecore
DB_USER=circlecore
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Email — Xneelo domain SMTP (TESTED: use smtp.yourdomain.co.za, port 465, SSL)
# smtp.xneelo.co.za is their shared host and is blocked outside Xneelo network.
# Your domain SMTP (smtp.circlecore.co.za) works from any server.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.circlecore.co.za
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=support@circlecore.co.za
EMAIL_HOST_PASSWORD=your-mailbox-password
DEFAULT_FROM_EMAIL=Circle Core <support@circlecore.co.za>
CIRCLE_CORE_SALES_EMAIL=support@circlecore.co.za

# PayFast (get credentials from payfast.co.za → My Account → Settings → Merchant Details)
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase-if-set
PAYFAST_SANDBOX=False

# Redis (required in production for caching across Gunicorn workers)
REDIS_URL=redis://127.0.0.1:6379/1
LOG_LEVEL=INFO
PRODUCT_CONTROL_API_ENABLED=False
GUEST_HOUSE_CONTROL_SECRET=replace-with-a-shared-random-secret-of-at-least-32-characters
# Staging only. Keep disabled in production. Restrict allowed_ips to the Smart Control staging egress address/range.
PRODUCT_CONTROL_API_KEYS_JSON={"scc-staging-key":{"secret_env":"GUEST_HOUSE_CONTROL_SECRET","identity":"smart-control-staging","permissions":["read.health","read.capabilities","read.plans","read.tenants","read.tenant","read.tenant_users","read.tenant_subscription","read.operation","read.audit","write.create_tenant","write.activate_tenant","write.suspend_tenant","write.reactivate_tenant","write.extend_trial","write.change_plan","write.convert_trial_to_paid","write.manual_payment","write.apply_grace_period","write.cancel_subscription","write.archive_tenant","write.enable_product","write.disable_product","write.invite_admin","write.invite_user","write.send_password_reset","write.force_password_reset","write.unlock_user","write.revoke_sessions","write.disable_user","write.reactivate_user","write.change_user_role"],"allowed_ips":["127.0.0.1/32"],"enabled":true}}

# ── DEPLOYMENT CHECKLIST ─────────────────────────────────────────────────────
# 1. Cron job (run daily to send trial reminder emails):
#    0 8 * * * /path/to/venv/bin/python /path/to/manage.py send_trial_reminders --settings=config.settings_production
#
# 2. WeasyPrint system dependencies (required for PDF generation):
#    sudo apt install libpango-1.0-0 libpangoft2-1.0-0 libcairo2 libgdk-pixbuf-2.0-0 libffi-dev libssl-dev
#
# 3. Static files (run once after deploy):
#    python manage.py collectstatic --settings=config.settings_production
#    Then configure Nginx to serve /staticfiles/ at /static/ and /media/ at /media/

SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=circlecore.co.za,.circlecore.co.za
BASE_DOMAIN=circlecore.co.za

# PostgreSQL (required — django-tenants does not support SQLite)
DB_NAME=circlecore
DB_USER=circlecore
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Email — Xneelo (smtp.xneelo.co.za)
# Create your mailboxes in Xneelo Control Panel → Email → Add Email Account
# Use the full email address as the username and the account password below
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.xneelo.co.za
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=hello@circlecore.co.za
EMAIL_HOST_PASSWORD=your-xneelo-email-password
DEFAULT_FROM_EMAIL=Circle Core <hello@circlecore.co.za>
CIRCLE_CORE_SALES_EMAIL=sales@circlecore.co.za

# PayFast (get credentials from payfast.co.za → My Account → Settings → Merchant Details)
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase-if-set
PAYFAST_SANDBOX=False

# Redis (required in production for rate limiting across Gunicorn workers)
REDIS_URL=redis://127.0.0.1:6379/1

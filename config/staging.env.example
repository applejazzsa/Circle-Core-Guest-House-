ENVIRONMENT=staging
APP_VERSION=staging
DEBUG=False
SECRET_KEY=set-through-the-staging-secret-store
ALLOWED_HOSTS=guesthouse.staging.circlecore.co.za,.guesthouse.staging.circlecore.co.za
BASE_DOMAIN=guesthouse.staging.circlecore.co.za

# Use an isolated staging PostgreSQL database. Never point these values at production.
DB_NAME=guesthouse_staging
DB_USER=guesthouse_staging
DB_PASSWORD=set-through-the-staging-secret-store
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/1

# Staging delivery is written to files and cannot contact Xneelo or customers.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=/app/runtime/mail
DEFAULT_FROM_EMAIL=Circle Core Guest House Staging <no-reply@staging.invalid>
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Payment-provider calls must remain sandboxed in staging.
PAYFAST_SANDBOX=True
PAYFAST_MERCHANT_ID=staging-sandbox-only
PAYFAST_MERCHANT_KEY=staging-sandbox-only
PAYFAST_PASSPHRASE=

PRODUCT_CONTROL_API_ENABLED=True
GUEST_HOUSE_CONTROL_SECRET=set-through-the-staging-secret-store
PRODUCT_CONTROL_API_KEYS_JSON={"scc-staging-key":{"secret_env":"GUEST_HOUSE_CONTROL_SECRET","identity":"smart-control-staging","permissions":["read.health","read.capabilities","read.plans","read.tenants","read.tenant","read.tenant_users","read.tenant_subscription","read.operation","read.audit","write.create_tenant","write.activate_tenant","write.suspend_tenant","write.reactivate_tenant","write.extend_trial","write.change_plan","write.convert_trial_to_paid","write.manual_payment","write.apply_grace_period","write.cancel_subscription","write.archive_tenant","write.enable_product","write.disable_product","write.invite_admin","write.invite_user","write.send_password_reset","write.force_password_reset","write.unlock_user","write.revoke_sessions","write.disable_user","write.reactivate_user","write.change_user_role"],"allowed_ips":["127.0.0.1/32"],"enabled":true}}
